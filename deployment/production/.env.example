# ── Database ────────────────────────────────────────────────────────────────────
DB_USERNAME=inquilino
DB_PASSWORD=CHANGE_ME_strong_password

# ── MinIO ───────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_min_8chars
MINIO_BUCKET=inquilino-docs
MINIO_LISTINGS_BUCKET=inquilino-listings

# ── OpenAI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_at_least_32_chars_long_random_string
JWT_EXPIRATION_MS=86400000

# ── CORS (comma-separated, no spaces) ──────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=https://inquilinofacile.it,https://www.inquilinofacile.it

# ── Frontend URL (used by OAuth2 redirect handler) ─────────────────────────────
FRONTEND_URL=https://inquilinofacile.it

# ── Superadmin ──────────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@inquilinofacile.it
SUPERADMIN_PASSWORD=CHANGE_ME_strong_password

# ── OAuth2 social login (leave empty to disable) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Mail (leave MAIL_ENABLED=false to disable) ─────────────────────────────────
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@inquilinofacile.it

# ── Web Push / VAPID (leave VAPID_ENABLED=false to disable) ────────────────────
VAPID_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Monitoring (Grafana) ────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password
GRAFANA_SMTP_PASSWORD=liRd2@M_inq

# ── Image tags ──────────────────────────────────────────────────────────────────
BACKEND_TAG=latest
FRONTEND_TAG=latest
